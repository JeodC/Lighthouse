string(REGEX MATCHALL "{[ \t\r\n]*LEVEL_([0-9A-Fa-f]+)_[A-Za-z0-9_]+,[ \t\r\n]*OVERLAY_([0-9A-Fa-f]+)_"
       ov_rows "${ovsrc}")
foreach(row IN LISTS ov_rows)
