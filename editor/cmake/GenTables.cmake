file(GLOB_RECURSE csrc "${SRC_ROOT}/src/*.c")
set(rows "")
set(tok "[ \t\r\n]*([A-Za-z0-9_]+)[ \t\r\n]*")
foreach(f IN LISTS csrc)
  file(READ "${f}" text)
  if(NOT text MATCHES "ActorInfo")
    continue()
  endif()
  string(REGEX REPLACE "//[^\n]*" "" text "${text}")
  string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" "" text "${text}")
  string(REGEX MATCHALL "ActorInfo[ \t\r\n]+[A-Za-z0-9_]+[ \t\r\n]*=[ \t\r\n]*{${tok},${tok},${tok},"
         infos "${text}")
  foreach(info IN LISTS infos)
    string(REGEX MATCH "ActorInfo[ \t\r\n]+([A-Za-z0-9_]+)" _ "${info}")
    set(sym "${CMAKE_MATCH_1}")
    string(REGEX MATCH "{${tok},${tok},${tok},$" _ "${info}")
    token_id(actor "${CMAKE_MATCH_2}")
    token_id(model "${CMAKE_MATCH_3}")
    if(actor STREQUAL "")
      continue()
    endif()
    trim_hex(actor_trimmed "${actor}")
    set(aid_${sym} "${actor_trimmed}")
    if(model STREQUAL "")
      continue()
    endif()
    pad_hex(key "${actor}")
    trim_hex(model "${model}")
    list(APPEND rows "${key}|    {0x${actor_trimmed}, 0x${model}},")
  endforeach()
endforeach()
emit_unique_rows("${OUT_DIR}/ActorModels.inc" rows n_models)

