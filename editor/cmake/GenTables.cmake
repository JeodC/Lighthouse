file(READ "${SRC_ROOT}/src/core2/gc/section.c" secsrc)
string(REGEX REPLACE "//[^\n]*" "" secsrc "${secsrc}")
string(REGEX MATCH "MapInfo D_8036B810\\[[^]]*\\] *={(.*)};" _ "${secsrc}")
set(sec_body "${CMAKE_MATCH_1}")
string(REGEX MATCHALL "{[ \t\r\n]*MAP_([0-9A-Fa-f]+)_[A-Za-z0-9_]+,[ \t\r\n]*LEVEL_([0-9A-Fa-f]+)_"
       map_rows "${sec_body}")
set(rows "")
foreach(row IN LISTS map_rows)
  string(REGEX MATCH "MAP_([0-9A-Fa-f]+)_[A-Za-z0-9_]+,[ \t\r\n]*LEVEL_([0-9A-Fa-f]+)_" _ "${row}")
  string(TOUPPER "${CMAKE_MATCH_2}" lvl)
  if(NOT DEFINED lvl2ov_${lvl})
    continue()
  endif()
  trim_hex(map_hex "${CMAKE_MATCH_1}")
  pad_hex(key "${CMAKE_MATCH_1}")
  list(APPEND rows "${key}|    { 0x${map_hex}, 0x${lvl2ov_${lvl}} },")
endforeach()
emit_unique_rows("${OUT_DIR}/MapOverlays.inc" rows n_mapov)

