  string(REGEX REPLACE "[ \t\r\n]" "" cube_min "${cube_min}")
  string(REGEX REPLACE "[ \t\r\n]" "" cube_max "${cube_max}")
  if(opa STREQUAL "" OR opa STREQUAL "0")
