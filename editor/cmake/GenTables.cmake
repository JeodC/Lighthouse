function(trim_hex out hex)
  string(TOUPPER "${hex}" hex)
  string(REGEX REPLACE "^0+([0-9A-F])" "\\1" hex "${hex}")
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

function(pad_hex out hex)
  string(TOUPPER "${hex}" hex)
  string(LENGTH "${hex}" len)
  while(len LESS 4)
    set(hex "0${hex}")
    math(EXPR len "${len} + 1")
  endwhile()
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

function(write_if_changed path content)
  set(old "")
  if(EXISTS "${path}")
    file(READ "${path}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${path}" "${content}")
  endif()
endfunction()

function(emit_unique_rows path rows_var count_var)
  set(rows "${${rows_var}}")
  list(SORT rows)
  list(REMOVE_DUPLICATES rows)
  set(out "")
  set(last "")
  set(count 0)
  foreach(row IN LISTS rows)
    string(REGEX REPLACE "^([0-9A-F]+)\\|(.*)$" "\\1" key "${row}")
    string(REGEX REPLACE "^([0-9A-F]+)\\|(.*)$" "\\2" line "${row}")
    if(NOT key STREQUAL last)
      set(last "${key}")
      math(EXPR count "${count} + 1")
      string(APPEND out "${line}\n")
    endif()
  endforeach()
  write_if_changed("${path}" "${out}")
  set(${count_var} ${count} PARENT_SCOPE)
endfunction()

