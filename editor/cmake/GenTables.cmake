  set(map_name "${CMAKE_MATCH_2}")
  set(opa_tok "${CMAKE_MATCH_3}")
  set(xlu_tok "${CMAKE_MATCH_4}")
  set(cube_min "${CMAKE_MATCH_5}")
  set(cube_max "${CMAKE_MATCH_6}")
  set(scale "${CMAKE_MATCH_7}")
