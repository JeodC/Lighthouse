macro(collect_spawn_adds text_var overlay)
  string(REGEX MATCHALL "spawnableActorList_add[A-Za-z]*[ \t\r\n]*\\([ \t\r\n]*&[ \t\r\n]*[A-Za-z0-9_]+"
         adds "${${text_var}}")
  foreach(add IN LISTS adds)
    string(REGEX MATCH "&[ \t\r\n]*([A-Za-z0-9_]+)$" _ "${add}")
    set(sym "${CMAKE_MATCH_1}")
    if(DEFINED aid_${sym})
      pad_hex(key "${aid_${sym}}")
      list(APPEND spawn_rows "${overlay}${key}|    { 0x${overlay}, 0x${aid_${sym}} },")
    else()
      message(WARNING "editor tables: no ActorInfo found for spawnable '${sym}'")
    endif()
  endforeach()
endmacro()

