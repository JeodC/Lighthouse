function(token_id out tok)
  string(STRIP "${tok}" tok)
  if(tok MATCHES "^(ACTOR|ASSET|MARKER)_([0-9A-Fa-f]+)_")
    set(${out} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  elseif(tok MATCHES "^0[xX]([0-9A-Fa-f]+)$")
    set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  elseif(tok MATCHES "^[0-9]+$")
    math(EXPR v "${tok}" OUTPUT_FORMAT HEXADECIMAL)
    string(REGEX REPLACE "^0[xX]" "" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

file(READ "${SRC_ROOT}/src/core2/gccube.c" gccube)
string(FIND "${gccube}" "func_803084F0" exit_fn_pos)
set(rows "")
if(exit_fn_pos GREATER -1)
  string(SUBSTRING "${gccube}" ${exit_fn_pos} -1 exit_fn)
  string(FIND "${exit_fn}" "default:" exit_fn_end)
  if(exit_fn_end GREATER -1)
    string(SUBSTRING "${exit_fn}" 0 ${exit_fn_end} exit_fn)
  endif()
  string(REGEX MATCHALL "case[ \t]*(0[xX][0-9A-Fa-f]+|[0-9]+)[ \t]*:[ \t]*[A-Za-z0-9_]+[ \t]*=[ \t]*ACTOR_[0-9A-Fa-f]+_"
         exit_cases "${exit_fn}")
  foreach(one IN LISTS exit_cases)
    string(REGEX MATCH "case[ \t]*(0[xX][0-9A-Fa-f]+|[0-9]+)[ \t]*:[ \t]*[A-Za-z0-9_]+[ \t]*=[ \t]*ACTOR_([0-9A-Fa-f]+)_"
           _ "${one}")
    set(exit_tok "${CMAKE_MATCH_1}")
    set(actor_hex "${CMAKE_MATCH_2}")
    token_id(exit_hex "${exit_tok}")
    trim_hex(exit_hex "${exit_hex}")
    trim_hex(actor_hex "${actor_hex}")
    pad_hex(key "${exit_hex}")
    list(APPEND rows "${key}|    { 0x${exit_hex}, 0x${actor_hex} },")
  endforeach()
endif()
emit_unique_rows("${OUT_DIR}/ExitActors.inc" rows n_exits)
if(n_exits EQUAL 0)
